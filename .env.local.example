# ─────────────────────────────────────────────────────────────
# Elbrit Trendo 2026 — environment configuration
# Copy this file to `.env.local` and fill in to enable live ERP.
# Leave ERP_ENABLED unset/false to just store leads locally + log them.
# ─────────────────────────────────────────────────────────────

# Master switch for pushing leads into ERPNext. "true" to turn on.
ERP_ENABLED=false

# ERPNext connection (UAT or production). Base URL, NO trailing /api.
ERP_URL=https://uat.elbrit.org
ERP_API_KEY=
ERP_API_SECRET=

# DocType to create per submission (CRM Lead by default).
ERP_DOCTYPE=Lead

# Tag every lead from this site so they're filterable in the CRM.
ERP_LEAD_SOURCE=Trendo 2026 Landing Page
